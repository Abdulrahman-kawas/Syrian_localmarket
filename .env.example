# Application
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production

# Database (Azure PostgreSQL Flexible Server + PostGIS)
DATABASE_URL=postgresql://user:password@host:5432/localmarket?sslmode=require

# Azure Key Vault
AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net/
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# Azure Storage (Blob + CDN)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_CDN_ENDPOINT=

# Azure Communication Services (Email)
ACS_CONNECTION_STRING=
ACS_SENDER_EMAIL=noreply@yourdomain.com

# Azure Notification Hubs
AZURE_NOTIFICATION_HUBS_CONNECTION_STRING=
AZURE_NOTIFICATION_HUBS_HUB_NAME=

# Azure SignalR Service
AZURE_SIGNALR_CONNECTION_STRING=
AZURE_SIGNALR_HUB_NAME=

# Google Maps Platform (ALL KEYS SERVER-SIDE ONLY)
GOOGLE_MAPS_API_KEY=

# Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Auth
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# File Uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# CORS (development only)
CORS_ORIGINS=["http://localhost:3000","http://localhost:19006"]
